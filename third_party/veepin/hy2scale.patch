+// runBatch is Run for a userspace device that reads bursts: consecutive
+// packets for one tunnel are encapsulated together and flushed with one
+// batched send, exactly as runVnet flushes a super-frame's segments. Anything
+// needing individual treatment (paced tunnels, frag-needed, no route) goes
+// through routeOutbound after the pending burst is flushed, so order holds.
+// (hy2scale P6)
+func (p *Pump) runBatch(br BatchReader) {
+	const burst = 64
+	bufs := make([][]byte, burst)
+	for i := range bufs {
+		bufs[i] = make([]byte, 65535)
+	}
+	sizes := make([]int, burst)
+	outs := make([][]byte, 0, burst)
+	var cur Tunnel
+	flush := func() {
+		if len(outs) > 0 {
+			p.batchSend(outs, cur.PeerAddr())
+		}
+		outs = outs[:0]
+		cur = nil
+	}
+	for {
+		n, err := br.ReadBatch(bufs, sizes)
+		if err != nil {
+			if p.closing.Load() {
+				return
+			}
+			if p.log != nil {
+				p.log.Warnf("dataplane: device read error: %v", err)
+			}
+			return
+		}
+		v := p.tables.Load()
+		mtu := p.innerMTU()
+		for i := range n {
+			pkt := bufs[i][:sizes[i]]
+			dst, ok := innerDest(pkt)
+			if !ok {
+				p.drops[DropNotIP].Add(1)
+				continue
+			}
+			b := v.routes.lookup(dst)
+			if b.t == nil || b.paced != nil || (mtu > 0 && NeedsFragmentation(pkt, mtu)) {
+				flush()
+				p.routeOutbound(pkt)
+				continue
+			}
+			if cur != nil && b.t != cur {
+				flush()
+			}
+			cur = b.t
+			out, err := p.encap(b, pkt, mtu, p.burstBuf(len(outs)))
+			if err != nil {
+				p.drops[DropEncapFailed].Add(1)
+				continue
+			}
+			b.c.countTx(len(pkt))
+			outs = append(outs, out)
+		}
+		flush()
+	}
+}
+
