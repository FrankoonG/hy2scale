#!/bin/sh /etc/rc.common
# hy2scale service (procd). Settings: /etc/config/hy2scale.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/hy2scale
EXTRA_COMMANDS="fwclean"
EXTRA_HELP="	fwclean	Remove the firewall rules made for hy2scale"

# port of the web UI: the configured one, else hy2scale's own setting
ui_port() {
	local p="$1" dir="$2" l
	if [ -z "$p" ] && [ -f "$dir/config.yaml" ]; then
		l="$(sed -n 's/^ui_listen:[[:space:]]*["'\'']\{0,1\}\([^"'\'']*\).*/\1/p' "$dir/config.yaml" | head -n1)"
		p="${l##*:}"
	fi
	echo "${p:-5565}"
}

# fw_rule NAME PORT PROTO: one "hy2scale_*" rule letting PORT in from wan
fw_add() {
	local sec="hy2scale_$1" port="$2" proto="$3" label
	label="$(echo "$proto" | tr ' ' '+')"
	uci -q batch <<-EOF
		set firewall.$sec=rule
		set firewall.$sec.name='hy2scale $port/$label'
		set firewall.$sec.src='wan'
		set firewall.$sec.dest_port='$port'
		set firewall.$sec.proto='$proto'
		set firewall.$sec.target='ACCEPT'
	EOF
}

fw_state() {
	uci -q show firewall | grep '^firewall\.hy2scale_' | sort
}

fw_clear() {
	local s
	for s in $(uci -q show firewall | sed -n 's/^firewall\.\(hy2scale_[A-Za-z0-9_]*\)=.*/\1/p'); do
		uci -q delete "firewall.$s"
	done
}

fw_port() {
	local entry="$1" port proto
	port="${entry%%/*}"
	proto="${entry#*/}"
	[ "$proto" = "$entry" ] && proto=any
	case "$proto" in
		tcp | udp) ;;
		any | both | "") proto="tcp udp" ;;
		*) logger -t hy2scale "wan_port '$entry': unknown protocol"; return ;;
	esac
	case "$port" in
		*[!0-9-]* | "" | -* | *- | *-*-*) logger -t hy2scale "wan_port '$entry': bad port"; return ;;
	esac
	FW_N=$((FW_N + 1))
	fw_add "p$FW_N" "$port" "$proto"
}

# fw_sync ENABLED DATA_DIR UI_PORT: firewall rules as configured, reloading
# the firewall only when they changed
fw_sync() {
	local enabled="$1" dir="$2" uiport="$3" before wan_ui
	before="$(fw_state)"
	fw_clear
	FW_N=0
	if [ "$enabled" = 1 ]; then
		config_get_bool wan_ui main wan_ui 0
		[ "$wan_ui" = 1 ] && fw_add ui "$(ui_port "$uiport" "$dir")" tcp
		config_list_foreach main wan_port fw_port
	fi
	if [ "$before" != "$(fw_state)" ]; then
		uci -q commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1
	else
		uci -q revert firewall
	fi
}

start_service() {
	local enabled data_dir uiport base_path mem_limit
	config_load hy2scale
	config_get_bool enabled main enabled 0
	config_get data_dir main data_dir /etc/hy2scale
	config_get uiport main ui_port
	config_get base_path main base_path
	config_get mem_limit main mem_limit

	fw_sync "$enabled" "$data_dir" "$uiport"
	[ "$enabled" = 1 ] || return 0

	mkdir -p "$data_dir"
	procd_open_instance
	procd_set_param command "$PROG" --data "$data_dir"
	[ -n "$uiport" ] && procd_append_param command --api ":$uiport"
	[ -n "$base_path" ] && procd_append_param command --base-path "$base_path"
	# log lines at info level in logd; a crash (stderr) at err
	if [ -n "$mem_limit" ]; then
		procd_set_param env HY2SCALE_LOG_STDOUT=1 GOMEMLIMIT="${mem_limit}MiB"
	else
		procd_set_param env HY2SCALE_LOG_STDOUT=1
	fi
	# a package upgrade replaces the binary: restart on the next start/reload
	procd_set_param file "$PROG"
	procd_set_param limits nofile="65535 65535"
	# a restart asked for from the web UI exits too: always come back
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}

service_triggers() {
	procd_add_reload_trigger hy2scale
}

fwclean() {
	local before
	before="$(fw_state)"
	fw_clear
	if [ -n "$before" ]; then
		uci -q commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1
	fi
	return 0
}
